<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de episodio: número grande, título, progreso y "visto". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/ep_card_width"
    android:layout_height="@dimen/ep_card_height"
    android:background="@drawable/bg_episode_card"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/ep_number"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ep_watched"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="@string/watched_badge"
        android:textColor="@color/brand"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/ep_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/brand"
        android:visibility="gone" />
</FrameLayout>
